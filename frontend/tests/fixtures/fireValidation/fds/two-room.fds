&HEAD CHID='two_room', TITLE='NBS-like fire room and entry, 110 kW, 0.1 m' /
&TIME T_END=180. /
&MISC TMPA=20. /
&DUMP SMOKE3D=.FALSE., DT_DEVC=1., DT_HRR=1., DT_PL3D=1000., DT_RESTART=1000. /
&MESH IJK=35,24,22, XB=0.0,3.5,0.0,2.4,0.0,2.2 /

&REAC FUEL='METHANE', RADIATIVE_FRACTION=0.2 /

&MATL ID='FIREBRICK', CONDUCTIVITY=0.36, SPECIFIC_HEAT=1.04, DENSITY=750. /
&MATL ID='CERAMIC', CONDUCTIVITY=0.09, SPECIFIC_HEAT=1.04, DENSITY=128. /
&MATL ID='MARINITE', CONDUCTIVITY=0.12, SPECIFIC_HEAT=1.25, DENSITY=720. /
&MATL ID='GYPSUM', CONDUCTIVITY=0.17, SPECIFIC_HEAT=1.09, DENSITY=930. /

&SURF ID='FIREBRICK', MATL_ID='FIREBRICK', THICKNESS=0.113, BACKING='INSULATED' /
&SURF ID='CERAMIC', MATL_ID='CERAMIC', THICKNESS=0.05, BACKING='INSULATED' /
&SURF ID='MARINITE', MATL_ID='MARINITE', THICKNESS=0.0127, BACKING='INSULATED' /
&SURF ID='GYPSUM', MATL_ID='GYPSUM', THICKNESS=0.0127, BACKING='INSULATED' /
&SURF ID='BURNER', HRRPUA=916.667, RAMP_Q='grow', COLOR='RED' /
&RAMP ID='grow', T=0., F=0. /
&RAMP ID='grow', T=10., F=1. /

&OBST XB=2.4,3.5,0.0,0.7,0.0,2.2, SURF_ID6='CERAMIC','MARINITE','CERAMIC','MARINITE','CERAMIC','CERAMIC' /
&OBST XB=2.4,3.5,1.7,2.4,0.0,2.2, SURF_ID6='CERAMIC','MARINITE','MARINITE','CERAMIC','CERAMIC','CERAMIC' /
&OBST XB=2.5,3.5,0.7,1.7,2.0,2.2, SURF_ID6='MARINITE','MARINITE','MARINITE','MARINITE','MARINITE','CERAMIC' /
&OBST XB=2.4,2.5,0.7,1.7,0.0,2.2, SURF_ID6='CERAMIC','MARINITE','MARINITE','MARINITE','CERAMIC','CERAMIC' /
&HOLE XB=2.35,2.55,0.8,1.6,0.0,1.6 /

&VENT XB=0.1,0.5,1.05,1.35,0.0,0.0, SURF_ID='BURNER' /
&VENT XB=3.5,3.5,0.8,1.6,0.0,1.6, SURF_ID='OPEN' /

&VENT XB=0.0,2.4,0.0,2.4,0.0,0.0, SURF_ID='FIREBRICK' /
&VENT XB=2.5,3.5,0.7,1.7,0.0,0.0, SURF_ID='GYPSUM' /
&VENT XB=0.0,2.4,0.0,2.4,2.2,2.2, SURF_ID='CERAMIC' /
&VENT XB=0.0,0.0,0.0,2.4,0.0,2.2, SURF_ID='CERAMIC' /
&VENT XB=0.0,2.4,0.0,0.0,0.0,2.2, SURF_ID='CERAMIC' /
&VENT XB=0.0,2.4,2.4,2.4,0.0,2.2, SURF_ID='CERAMIC' /
&VENT XB=3.5,3.5,0.7,0.8,0.0,2.0, SURF_ID='MARINITE' /
&VENT XB=3.5,3.5,1.6,1.7,0.0,2.0, SURF_ID='MARINITE' /
&VENT XB=3.5,3.5,0.8,1.6,1.6,2.0, SURF_ID='MARINITE' /

&DEVC XB=1.2,1.2,1.2,1.2,0.0,2.2, QUANTITY='LAYER HEIGHT', ID='fire-z' /
&DEVC XB=1.2,1.2,1.2,1.2,0.0,2.2, QUANTITY='UPPER TEMPERATURE', ID='fire-Tu' /
&DEVC XB=1.2,1.2,1.2,1.2,0.0,2.2, QUANTITY='LOWER TEMPERATURE', ID='fire-Tl' /
&DEVC XB=3.0,3.0,1.2,1.2,0.0,2.0, QUANTITY='LAYER HEIGHT', ID='entry-z' /
&DEVC XB=3.0,3.0,1.2,1.2,0.0,2.0, QUANTITY='UPPER TEMPERATURE', ID='entry-Tu' /
&DEVC XB=3.0,3.0,1.2,1.2,0.0,2.0, QUANTITY='LOWER TEMPERATURE', ID='entry-Tl' /
&DEVC XB=2.5,2.5,0.8,1.6,0.0,1.6, QUANTITY='MASS FLOW +', ID='door-plus' /
&DEVC XB=2.5,2.5,0.8,1.6,0.0,1.6, QUANTITY='MASS FLOW -', ID='door-minus' /
&DEVC XB=3.5,3.5,0.8,1.6,0.0,1.6, QUANTITY='MASS FLOW +', ID='far-plus' /
&DEVC XB=3.5,3.5,0.8,1.6,0.0,1.6, QUANTITY='MASS FLOW -', ID='far-minus' /

&TAIL /
